{
  "name": "shinylaunchr",
  "version": "0.2.0-rc.1",
  "description": "A cross-platform desktop launchpad for R/Shiny apps.",
  "author": {
    "name": "Raban Heller",
    "email": "raban.heller@outlook.com",
    "url": "https://orcid.org/0000-0001-8006-9742"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/cttir/shinylaunchR",
  "repository": {
    "type": "git",
    "url": "https://github.com/cttir/shinylaunchR.git"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postbuild": "node scripts/verify-build.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "verify:fuses": "node scripts/verify-fuses.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "6.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
